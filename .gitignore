# Eval batteries produced by `pioneer eval prepare` — regenerated, never committed
/batteries/
/.evals/

# Corpus snapshots materialized from the manifest at run time.
# Only permissively-licensed excerpts are committed, under evals/files/.
# Anything fetched lives here and stays out of the repo.
**/evals/files-fetched/

# Eval run output
*.stdout
*.stderr
*.jsonl

.DS_Store

# Python bytecode from local script checks
__pycache__/
*.pyc

# Temporary one-case specs written by ad-hoc eval runs.
skills/*/evals/tmp-*.json

# Node devDependencies & local tarballs
/node_modules/
/*.tgz
.android-ux/config.local.json
